# Ignore heavy/generated data artifacts
# Raw/uncompressed CSVs and processed exports can be large
# Keep the source notebooks/docs tracked, but ignore generated outputs
/data/*.csv
/data/*.csv.gz
/data/*.parquet
/data/*.pkl
/data/*.joblib

# Model outputs and training artifacts
models/
*.pkl
*.joblib

# Python & Jupyter
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Virtual Environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# OS noise
.DS_Store
Thumbs.db
